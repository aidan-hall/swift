// RUN: %target-swift-frontend -emit-irgen -disable-availability-checking -enable-experimental-feature BuiltinModule %s | %FileCheck %s

// REQUIRES: swift_feature_BuiltinModule

import Builtin
import Swift

// CHECK-LABEL: define{{.*}} @vector_extract_index2
// CHECK: [[BASE:%.*]] = alloca
// CHECK: [[SLOT:%.*]] = getelementptr inbounds i32, ptr [[BASE]], i64 2
// CHECK: [[VAL:%.*]] = load i32, ptr [[SLOT]]
// CHECK: ret i32 [[VAL]]
sil @vector_extract_index2 : $@convention(thin) (Builtin.FixedArray<4, Builtin.Int32>) -> Builtin.Int32 {
entry(%v : $Builtin.FixedArray<4, Builtin.Int32>):
  %i = integer_literal $Builtin.Word, 2
  %r = vector_extract %v : $Builtin.FixedArray<4, Builtin.Int32>, %i : $Builtin.Word
  return %r : $Builtin.Int32
}

// CHECK-LABEL: define{{.*}} @vector_extract_index0
// CHECK: [[BASE:%.*]] = alloca
// CHECK: [[SLOT:%.*]] = getelementptr inbounds i32, ptr [[BASE]], i64 0
// CHECK: [[VAL:%.*]] = load i32, ptr [[SLOT]]
// CHECK: ret i32 [[VAL]]
sil @vector_extract_index0 : $@convention(thin) (Builtin.FixedArray<4, Builtin.Int32>) -> Builtin.Int32 {
entry(%v : $Builtin.FixedArray<4, Builtin.Int32>):
  %i = integer_literal $Builtin.Word, 0
  %r = vector_extract %v : $Builtin.FixedArray<4, Builtin.Int32>, %i : $Builtin.Word
  return %r : $Builtin.Int32
}
