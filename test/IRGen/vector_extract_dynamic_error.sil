// RUN: not %target-swift-frontend -emit-irgen -disable-availability-checking -enable-experimental-feature BuiltinModule %s 2>&1 | %FileCheck %s

// REQUIRES: swift_feature_BuiltinModule

import Builtin
import Swift

// CHECK: error: {{.*}}vector_extract requires a constant integer index
sil @vector_extract_dynamic : $@convention(thin) (Builtin.FixedArray<4, Builtin.Int32>, Builtin.Word) -> Builtin.Int32 {
entry(%v : $Builtin.FixedArray<4, Builtin.Int32>, %i : $Builtin.Word):
  %r = vector_extract %v : $Builtin.FixedArray<4, Builtin.Int32>, %i : $Builtin.Word
  return %r : $Builtin.Int32
}
