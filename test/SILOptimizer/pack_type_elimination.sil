// RUN: %target-sil-opt %s -module-name A -pack-type-elimination | %FileCheck %s

sil_stage canonical

import Builtin
import Swift

protocol P {
  associatedtype A
  func f() -> A
}

extension P {
  func f() -> some Any
}

sil [ossa] @use : $@convention(thin) <T> (@in T) -> ()

// CHECK-LABEL: sil [ossa] @constant_dpi : $@convention(thin) (Builtin.RawPointer) -> () {
// CHECK:         pointer_to_address %0 to $*Int32
// CHECK-LABEL: } // end sil function 'constant_dpi'
sil [ossa] @constant_dpi : $@convention(thin) (Builtin.RawPointer) -> () {
bb0(%0 : $Builtin.RawPointer):
  %zero = integer_literal $Builtin.Word, 0
  %dpi0 = dynamic_pack_index %zero of $Pack{Int32, Int64}
  %ope0 = open_pack_element %dpi0 of <each T> at <Pack{Int32, Int64}>, shape $each T, id 1
  %addr = pointer_to_address %0 to $*@pack_element(1) each T

  %res = tuple ()
  return %res
}

// CHECK-LABEL: sil [ossa] @dynamic_dpi : $@convention(thin) (Builtin.RawPointer, Builtin.Word) -> () {
// CHECK:         pointer_to_address %0 to $*Int32
// CHECK-LABEL: } // end sil function 'dynamic_dpi'
sil [ossa] @dynamic_dpi : $@convention(thin) (Builtin.RawPointer, Builtin.Word) -> () {
bb0(%0 : $Builtin.RawPointer, %1 : $Builtin.Word):
  %dpi0 = dynamic_pack_index %1 of $Pack{Int32, Int64}
  %ope0 = open_pack_element %dpi0 of <each T> at <Pack{Int32, Int64}>, shape $each T, id 2
  %addr = pointer_to_address %0 to $*@pack_element(2) each T

  %res = tuple ()
  return %res
}

// CHECK-LABEL: sil [ossa] @homogeneous_dpi : $@convention(thin) (Builtin.RawPointer, Builtin.Word) -> () {
// CHECK:         pointer_to_address %0 to $*Int32
// CHECK-LABEL: } // end sil function 'homogeneous_dpi'
sil [ossa] @homogeneous_dpi : $@convention(thin) (Builtin.RawPointer, Builtin.Word) -> () {
bb0(%0 : $Builtin.RawPointer, %1 : $Builtin.Word):
  %dpi0 = dynamic_pack_index %1 of $Pack{Int32, Int32}
  %ope0 = open_pack_element %dpi0 of <each T> at <Pack{Int32, Int32}>, shape $each T, id 3
  %addr = pointer_to_address %0 to $*@pack_element(3) each T

  %res = tuple ()
  return %res
}

// CHECK-LABEL: sil [ossa] @constant_ppi : $@convention(thin) (Builtin.RawPointer) -> () {
// CHECK:         pointer_to_address %0 to $*Int32
// CHECK-LABEL: } // end sil function 'constant_ppi'
sil [ossa] @constant_ppi : $@convention(thin) (Builtin.RawPointer) -> () {
bb0(%0 : $Builtin.RawPointer):
  %zero = integer_literal $Builtin.Word, 0
  %dpi0 = dynamic_pack_index %zero of $Pack{Int32, Int64}
  %ppi0 = pack_pack_index 0, %dpi0 of $Pack{Int32, Int64}
  %ope0 = open_pack_element %ppi0 of <each T> at <Pack{Int32, Int64}>, shape $each T, id 4
  %addr = pointer_to_address %0 to $*@pack_element(4) each T

  %res = tuple ()
  return %res
}

// CHECK-LABEL: sil [ossa] @homogeneous_loop : $@convention(thin) (@pack_guaranteed Pack{Int32, Int32}) -> () {
// CHECK:       bb1([[I:%[0-9]+]] : $Builtin.Word):
// CHECK:         [[DPI:%[0-9]+]] = dynamic_pack_index [[I]] of $Pack{Int32, Int32}
// CHECK:         pack_element_get [[DPI]] of %0 as $*Int32
// CHECK-LABEL: } // end sil function 'homogeneous_loop'
sil [ossa] @rolled_homogeneous_loop : $@convention(thin) (@pack_guaranteed Pack{Int32, Int32}) -> () {
bb0(%0 : $*Pack{Int32, Int32}):
  %zero = integer_literal $Builtin.Word, 0
  br bb1(%zero)

bb1(%i : $Builtin.Word):
  %dpi0 = dynamic_pack_index %i of $Pack{Int32, Int32}
  %ope0 = open_pack_element %dpi0 of <each T> at <Pack{Int32, Int32}>, shape $each T, id 5
  %addr = pack_element_get %dpi0 of %0 as $*@pack_element(5) each T
  cond_br undef, bb2, bb3

bb2:
  br bb1(%i)

bb3:
  %res = tuple ()
  return %res
}
